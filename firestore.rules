rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check roles from custom claims
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    
    function isExecutive() {
      return request.auth != null && request.auth.token.role == 'executive';
    }
    
    function isDoctor() {
      return request.auth != null && request.auth.token.role == 'doctor';
    }

    function isStaff() {
      return request.auth != null && request.auth.token.role == 'staff';
    }

    function isPatient() {
      // By default, newly registered patients via Google Auth won't have a role claim immediately
      return request.auth != null && (request.auth.token.role == 'user' || !('role' in request.auth.token));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admissions collection
    match /admissions/{admissionId} {
      allow read: if isAdmin() 
                  || isExecutive()
                  || (isDoctor() && resource.data.department == request.auth.token.department)
                  || (isStaff() && resource.data.ward == request.auth.token.ward)
                  || isPatient();
      
      // Allow write for Admin (config/seeding) and for Doctor/Staff to update status
      allow write: if isAdmin() 
                  || (isDoctor() && resource.data.department == request.auth.token.department)
                  || (isStaff() && resource.data.ward == request.auth.token.ward);
    }

    // Lab Orders collection
    match /lab_orders/{orderId} {
      allow read: if isAdmin() 
                  || isExecutive()
                  || (isDoctor() && resource.data.department == request.auth.token.department)
                  || (isStaff()) // Staff can view to update sample collection
                  || isPatient();
                  
      allow write: if isAdmin() 
                  || (isDoctor() && resource.data.department == request.auth.token.department)
                  || isStaff(); // Staff can update sample collection status
    }

    // Daily Occupancy (Manual) collection
    match /daily_occupancy_manual/{occupancyId} {
      // Executives can view aggregated/hospital-wide data
      allow read: if isAdmin() || isExecutive() || isStaff();
      // Staff can write/update manual occupancy logs for their own ward
      allow write: if isAdmin() || (isStaff() && resource.data.Ward == request.auth.token.ward);
    }

    // Metrics / Aggregated Dashboards (For Executives)
    match /metrics/{metricId} {
      allow read: if isAdmin() || isExecutive();
      allow write: if isAdmin(); // Usually written by Cloud Functions/Admin SDK
    }
    // Beds collection
    match /beds/{bedId} {
      allow read: if request.auth != null; // All authenticated users can read beds
      allow write: if isAdmin() || (isStaff() && resource.data.ward == request.auth.token.ward);
    }

    // Machines collection
    match /machines/{machineId} {
      allow read: if request.auth != null; // All authenticated users can read machines
      allow write: if isAdmin() || (isStaff() && resource.data.ward == request.auth.token.ward);
    }

    // Medicines collection
    match /medicines/{medicineId} {
      allow read: if request.auth != null; // All authenticated users can read medicines
      allow write: if isAdmin(); // Only admins can manage medicines
    }

    // OPD Visits Collection
    match /opd_visits/{visitId} {
      // Doctors can read visits assigned to their department
      // Staff can read all OPD visits
      allow read: if isAdmin() 
                  || isStaff() 
                  || (isDoctor() && resource.data.assigned_department == request.auth.token.department);
      
      // Staff can create visits, Doctors can update them (e.g. status)
      allow write: if isAdmin() 
                  || isStaff() 
                  || (isDoctor() && resource.data.assigned_department == request.auth.token.department);
    }

    // Doctor Status Collection
    match /doctor_status/{doctorId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == doctorId;
    }
    // Chat History collection
    match /chat_history/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId;
    }

    // Triage History collection
    match /triage_history/{triageId} {
      allow read, write: if isStaff() || isAdmin() || isExecutive() || isDoctor();
    }
  }
}
